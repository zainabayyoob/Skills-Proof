# ===============================================================
# SkillProof Environment Configuration (.env)
# ===============================================================

# --- Server & Port Configuration ---
PORT=3001
PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# --- Database Configuration (PostgreSQL / Neon Persistent Storage) ---
# When DATABASE_URL is set, SkillProof connects to PostgreSQL (Neon Free Tier).
# When DATABASE_URL is omitted, SkillProof falls back to local server/data/db.json storage for offline development.
# NOTE: Never commit your actual connection string or credentials to Git.
# DATABASE_URL=postgresql://<username>:<password>@<neon-hostname>/<database>?sslmode=require

# --- Authentication & JWT Security ---
JWT_SECRET=skillproof_jwt_secret_sih2026_super_secure_key

# --- Google OAuth 2.0 Credentials ---
# Obtain from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" with Web Application type.
# 3. Add Authorized Redirect URI:
#    Development: http://localhost:3001/api/auth/oauth/google/callback
#    Production:  https://<your-domain>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
# Optional custom override for redirect URI (defaults to ${PUBLIC_URL}/api/auth/oauth/google/callback)
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/oauth/google/callback

# --- SMS Verification (Twilio - Optional) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# --- Email Verification (Resend / SendGrid - Optional) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=verify@skillproof.org

# --- Cloudflare Tunnel Configuration (Persistent Public URL) ---
# To prevent recurring Error 1033 and use a permanent, stable URL across restarts:
# 1. Open Cloudflare Zero Trust: https://one.dash.cloudflare.com
# 2. Go to Networks -> Tunnels -> Add a tunnel (Free).
# 3. Choose Cloudflare Tunnel, name it (e.g. "skillproof-dev"), and copy the Token.
# 4. Under Public Hostnames: route your subdomain (e.g. dev.yourdomain.com) to http://localhost:5173
# 5. Paste the token below:
# CLOUDFLARE_TUNNEL_TOKEN=<your_cloudflare_tunnel_token>
# CLOUDFLARE_TUNNEL_HOSTNAME=dev.yourdomain.com

